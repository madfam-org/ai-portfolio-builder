      "checkConstraints": {
        "jobs_status_check": {
          "name": "jobs_status_check",
          "value": "\"jobs\".\"status\" in ('saved', 'applying', 'applied', 'interview', 'offer', 'rejected', 'archived')"
        },
        "jobs_source_text_size_check": {
          "name": "jobs_source_text_size_check",
          "value": "char_length(\"jobs\".\"source_text\") between 1 and 50000"
        },
        "jobs_source_kind_check": {
          "name": "jobs_source_kind_check",
          "value": "\"jobs\".\"source_kind\" is null or \"jobs\".\"source_kind\" in ('paste', 'url', 'ats', 'capture', 'pdf', 'docx', 'file')"
        },
        "jobs_country_code_check": {
          "name": "jobs_country_code_check",
          "value": "\"jobs\".\"country_code\" is null or \"jobs\".\"country_code\" ~ '^[A-Z]{2}$'"
        },
        "jobs_state_code_check": {
          "name": "jobs_state_code_check",
          "value": "\"jobs\".\"state_code\" is null or \"jobs\".\"state_code\" ~ '^[A-Z]{2}-[A-Z0-9]{1,3}$'"
        },
        "jobs_employment_type_check": {
          "name": "jobs_employment_type_check",
          "value": "\"jobs\".\"employment_type\" is null or \"jobs\".\"employment_type\" in ('full_time', 'part_time', 'contract', 'temporary', 'internship', 'volunteer', 'per_diem', 'other')"
        },
        "jobs_work_mode_check": {
          "name": "jobs_work_mode_check",
          "value": "\"jobs\".\"work_mode\" is null or \"jobs\".\"work_mode\" in ('onsite', 'hybrid', 'remote')"
        },
        "jobs_salary_currency_check": {
          "name": "jobs_salary_currency_check",
          "value": "\"jobs\".\"salary_currency\" is null or \"jobs\".\"salary_currency\" ~ '^[A-Z]{3}$'"
        },
        "jobs_salary_period_check": {
          "name": "jobs_salary_period_check",
          "value": "\"jobs\".\"salary_period\" is null or \"jobs\".\"salary_period\" in ('hour', 'day', 'week', 'month', 'year')"
        },
        "jobs_salary_amounts_check": {
          "name": "jobs_salary_amounts_check",
          "value": "(\"jobs\".\"salary_min\" is null or \"jobs\".\"salary_min\" > 0) and (\"jobs\".\"salary_max\" is null or \"jobs\".\"salary_max\" > 0) and (\"jobs\".\"salary_min\" is null or \"jobs\".\"salary_max\" is null or \"jobs\".\"salary_min\" <= \"jobs\".\"salary_max\")"
        },
        "jobs_salary_unit_needs_amount_check": {
          "name": "jobs_salary_unit_needs_amount_check",
          "value": "(\"jobs\".\"salary_currency\" is null and \"jobs\".\"salary_period\" is null) or \"jobs\".\"salary_min\" is not null or \"jobs\".\"salary_max\" is not null"
        }
      },

# Local development only. Placeholders: never put real credentials in this file or in git.
# Wave 1 needs no secret at all. Production configuration is plain environment in
# infra/k8s/production/deployment.yaml; secrets (from the next wave) arrive only through the Enclii
# secret intake, by name.
#
# The host table: one row per public host. Exact, lowercase hostnames; any other Host gets a 404.
# Browsers resolve *.localhost to loopback, so http://cv.localhost:3000 works without /etc/hosts;
# with curl, pass -H 'Host: cv.localhost'. Unset, the hosts default to the production names.
CV_HOST_LANDING=cv.localhost
CV_HOST_APP=cv-app.localhost
CV_HOST_API=cv-api.localhost
# The landing is noindex unless this is exactly "true" (the brand is not ruled yet).
CV_INDEXABLE=false
# The git commit the image was built from (the Dockerfile sets it from a build arg). Empty locally.
CV_REVISION=

# --- W2: sign-in and data, DORMANT until set (docs/DEPLOYMENT.md "Identity and data"). Leave them empty to run
# exactly as wave 1. Never put real values in this file.
# Sign-in on cv-app needs ALL four; production values arrive through the Enclii intake (ExternalSecret cv-web-auth).
AUTH_JANUA_ISSUER=
AUTH_JANUA_CLIENT_ID=
AUTH_JANUA_CLIENT_SECRET=
# The session-cookie key (this app's own, never the Janua client secret). Locally: any long random string.
AUTH_SECRET=
# (Each empty KEY= line is followed by a comment or another KEY, never a bare value, so secret scanners stay quiet.)
# The only host sign-in answers on (defaults to CV_HOST_APP).
AUTH_PUBLIC_HOSTS=
# Runtime database (production: the cv_app role from onboarding). DATABASE_URL is the OWNER, for migrations; the
# runtime uses it only when NODE_ENV is development or test.
APP_DATABASE_URL=
DATABASE_URL=
# Postgres suite (pnpm test:pg): a throwaway database whose name ends in _test, and a cv_app role on it.
CV_TEST_OWNER_URL=
CV_TEST_APP_URL=

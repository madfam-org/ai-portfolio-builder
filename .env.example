# Local development only. Placeholders: never put real credentials, client ids or tokens in this file or in git.
# Production configuration is plain environment in infra/k8s/production/deployment.yaml; secrets arrive only through
# the Enclii secret intake, the OIDC provisioner or onboarding, by name (docs/DEPLOYMENT.md "Env contract").
# (Each empty KEY= line is followed by a comment or another KEY, never a bare value, so secret scanners stay quiet.)

# --- Configuration (plain environment; docs/DEPLOYMENT.md "Configuration")
# The host table: one row per public host. Exact, lowercase hostnames; any other Host gets a 404.
# Browsers resolve *.localhost to loopback, so http://cv.localhost:3000 works without /etc/hosts;
# with curl, pass -H 'Host: cv.localhost'. Unset, the hosts default to the production names.
CV_HOST_LANDING=cv.localhost
CV_HOST_APP=cv-app.localhost
CV_HOST_API=cv-api.localhost
# The pages host (published documents: /<slug>, /l/<token>). Unset = inert, not served. Production: cv-p.madfam.io.
CV_HOST_PAGES=
# The per-client token bucket on unauthenticated reads (pages host, cv-api public reads). Unset = 60 and 60.
CV_READ_LIMIT_BURST=
CV_READ_LIMIT_PER_MINUTE=
# The landing is noindex unless this is exactly "true" (the brand is not ruled yet).
CV_INDEXABLE=false
# The git commit the image was built from (the Dockerfile sets it from a build arg). Empty locally.
CV_REVISION=
# Bind address, production only: HOSTNAME=0.0.0.0 (keeps the proxy's rewrites internal). Leave it unset locally
# (shells often set HOSTNAME themselves), so it stays a comment here.
# The internal metrics listener (GET /metrics only). Production: 9090; "off" disables it (tests only).
CV_METRICS_PORT=

# --- Identity (docs/DEPLOYMENT.md "Identity and data"). Sign-in on cv-app needs ALL four; leave them empty and
# sign-in answers 503 not_configured. Production values arrive through the ExternalSecret cv-web-auth.
AUTH_JANUA_ISSUER=
AUTH_JANUA_CLIENT_ID=
AUTH_JANUA_CLIENT_SECRET=
# The session-cookie key (this app's own, never the Janua client secret). Locally: any long random string.
AUTH_SECRET=
# The only host sign-in answers on (defaults to CV_HOST_APP). AUTH_URL stays unset.
AUTH_PUBLIC_HOSTS=
# API token verification. Unset = cv-api and https://auth.madfam.io/.well-known/jwks.json.
CV_JANUA_AUDIENCE=
CV_JANUA_JWKS_URL=
# The Janua clients whose tokens cv-api accepts (comma-separated). Unset = AUTH_JANUA_CLIENT_ID.
CV_JANUA_CLIENT_IDS=

# --- Data. Without APP_DATABASE_URL the data routes answer 503 not_configured.
# Runtime database (production: the cv_app role from onboarding).
APP_DATABASE_URL=
# The database OWNER, for migrations; the runtime uses it only when NODE_ENV is development or test.
DATABASE_URL=
# Migrations prefer this over DATABASE_URL when set.
DIRECT_DATABASE_URL=
# Pool per pod. Unset = 3.
DATABASE_POOL_MAX=

# --- Market income range from Symbiosis HCM (W5-H). Without the client pair the panel stays dormant.
# Production: https://hcm-api.madfam.io. https only (loopback http for local tests).
HCM_API_URL=
HCM_CLIENT_ID=
HCM_CLIENT_SECRET=
# Optional. Unset = ${AUTH_JANUA_ISSUER}/api/v1/oauth/token and 3000 ms (200-10000).
HCM_TOKEN_URL=
HCM_TIMEOUT_MS=

# --- Reading images through tlacuilo. Dormant unless all three of the first values are set.
# https, or plain http to a cluster Service name (*.svc, *.svc.cluster.local).
TLACUILO_API_URL=
TLACUILO_CLIENT_ID=
TLACUILO_CLIENT_SECRET=
# Optional. Unset = ${AUTH_JANUA_ISSUER}/api/v1/oauth/token and 45000 ms (1000-70000).
TLACUILO_TOKEN_URL=
TLACUILO_TIMEOUT_MS=

# --- Import. "1", "true" or "on" shows the LinkedIn profile PDF import on /perfil (production: "1").
CV_IMPORT_LINKEDIN_PDF=

# --- Postgres suite (pnpm test:pg, pnpm test:e2e): a throwaway database whose name ends in _test, and a cv_app role on it.
CV_TEST_OWNER_URL=
CV_TEST_APP_URL=

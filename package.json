{
  "name": "ai-portfolio-builder",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "MADFAM CV (working label): the pre-launch landing, app shell and API for cv.madfam.io, cv-app.madfam.io and cv-api.madfam.io, served from one container.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madfam-org/ai-portfolio-builder.git"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "pnpm --filter @cv/web run lint",
    "typecheck": "pnpm --filter @cv/web run typecheck",
    "test": "pnpm --filter @cv/web run test",
    "build": "pnpm --filter @cv/web run build",
    "test:server": "pnpm --filter @cv/web run test:server",
    "test:pg": "pnpm --filter @cv/web run test:pg",
    "db:migrate": "pnpm --filter @cv/web run db:migrate",
    "db:generate": "pnpm --filter @cv/web run db:generate"
  }
}
